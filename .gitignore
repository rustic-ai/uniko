target/
*.db
.env
*.swp
*.swo
.DS_Store
proptest-regressions/
*.uni_cache*

# Bench artifacts: KB stores can be GB-scale (lance datasets), result
# JSONs are MB-scale.  Keep both out of git; preserve specific results
# manually when needed.
data/kb*/
data/lme_kb*/
data/locomo*.json
data/longmemeval*.json
data/cls_*.tsv
data/nlp_obs_test_diagnostics.txt
# Per-run event streams and logs (regeneratable from bench-configs +
# the source data file).  Same policy as the *.json result files.
data/*.log
data/logs/
data/*.json

# GPU wheel-variant Python sources — copied from bindings/uniko-py/python by
# scripts/bootstrap-wheel-variants.sh at build time (only Cargo.toml/pyproject/
# README are tracked per variant).
bindings/uniko-cuda/python/
bindings/uniko-metal/python/
data/*_events.jsonl
data/lme_*.json
data/abl_*.json
data/conv30_*.json

# Agent runtime state (claude-code, codex)
.claude/
.codex
.codex/

# Working notes that haven't been promoted to initial-docs/
NLP_REQUIREMENTS.md
locomo_results.json

# Python bytecode
__pycache__/
*.pyc

# Built wheels (maturin --out dist)
dist/

# Diagnostic dumps written by the `#[ignore]`d nlp_diagnostics / bench
# diagnostics tests (run with --run-ignored).
data/*.txt
